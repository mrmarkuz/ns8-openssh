{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>NethServer/.github:ns8"
    ],
    "packageRules": [
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["linuxserver/openssh-server"],            
            "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)_p(?<patch>\\d)-r(?<build>\\d)-ls(?<revision>\\d+)$"
        }
    ]
}
